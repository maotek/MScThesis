{
  "data_loader": {
    "dataset": "mvsec",
    "datapath": "datasets/MVSEC/data",
    "split": "train",
    "concatenate_sequences": false,
    "event_representation": {
      "representation_type": "rgb",
      "normalize": true,
      "white_frame": false,
      "height": 260,
      "width": 346
    },
    "preprocessing": [
      {
        "preprocessing_type": "Crop",
        "height": 260,
        "width": 346
      }
    ],
    "load_images": true,
    "batch_size": 1,
    "num_workers": 1,
    "pin_memory": true,
    "shuffle": false,
    "sequence_window": 1,
    "sequence_step": 1,
    "time_window_ms": 50
  },
  "model": {
    "model_type": "dav2",
    "input_size_width": 350,
    "input_size_height": 266
  },
  "vis_interval": 200,
  "vis_dir": "evaluate_output/evaluate_mvsec_train_dav2_rgb_sweep_0.1",
  "use_scaleshift": true,
  "clip_distance": 80.0,
  "inv_prediction": true,
  "inv_prediction_constant": 0.1,
  "csv_path": "evaluate_results/mvsec_train_dav2_rgb_sweep_0.1.csv"
}
