{
  "data_loader": {
    "dataset": "mvsec",
    "datapath": "datasets/MVSEC/data",
    "split": "test",
    "concatenate_sequences": false,
    "event_representation": {
      "representation_type": "voxelgrid",
      "channels": 5,
      "height": 260,
      "width": 346,
      "normalize": true
    },
    "preprocessing": [
      {
        "preprocessing_type": "Crop",
        "height": 260,
        "width": 346
      }
    ],
    "load_images": false,
    "batch_size": 1,
    "num_workers": 1,
    "pin_memory": true,
    "shuffle": false,
    "sequence_window": 1,
    "sequence_step": 1,
    "time_window_ms": 50
  },
  "model": {
    "model_type": "unet_dae",
    "input_channels": 5,
    "unet_base_channels": 32,
    "unet_type": "small",
    "dae_encoder": "vits",
    "dae_checkpoint": "models/depthanyevent/weights/dav2/finetuned_dsec/finetuned_dsec.pth",
    "input_size_width": 350,
    "input_size_height": 266,
    "freeze_dae": true,
    "dae_input_channels": 3,
    "dae_activation": "relu",
    "dae_scale_factor": 1.0,
    "dae_inv_prediction": true,
    "freeze_encoder": false,
    "dae_nopretrain": false,
    "checkpoint_path": "train_output/train_dsec_unet_dae_batch10/epoch_050.pt"
  },
  "vis_interval": 200,
  "vis_dir": "evaluate_output/evaluate_mvsec_unet_dae_batch10",
  "use_scaleshift": true,
  "clip_distance": 80.0,
  "inv_prediction": false,
  "inv_prediction_constant": 1.0,
  "csv_path": "evaluate_results/mvsec_validation_unet_dae_batch10.csv"
}
