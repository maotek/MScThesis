{
  "data_loader": {
    "dataset": "mvsec",
    "datapath": "datasets/MVSEC/data",
    "split": "train",
    "concatenate_sequences": false,
    "event_representation": {
      "representation_type": "voxelgrid",
      "channels": 5,
      "height": 260,
      "width": 346,
      "normalize": true
    },
    "preprocessing": [
      {
        "preprocessing_type": "Crop",
        "height": 260,
        "width": 346
      }
    ],
    "load_images": false,
    "batch_size": 10,
    "num_workers": 1,
    "pin_memory": true,
    "shuffle": true,
    "sequence_window": 1,
    "sequence_step": 1,
    "time_window_ms": 50
  },
  "model": {
    "model_type": "unet_dav2",
    "input_channels": 5,
    "unet_base_channels": 32,
    "dav2_encoder": "vits",
    "dav2_checkpoint": "models/dav2/checkpoints/depth_anything_v2_vits.pth",
    "input_size_width": 350,
    "input_size_height": 266,
    "freeze_dav2": true
  }
}
