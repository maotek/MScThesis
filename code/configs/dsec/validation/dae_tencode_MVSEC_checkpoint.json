{
  "data_loader": {
    "dataset": "dsec",
    "datapath": "datasets/DSEC/data",
    "split": "validation",
    "concatenate_sequences": false,
    "event_representation": {
      "representation_type": "tencode",
      "normalize": true,
      "white_frame": false,
      "height": 480,
      "width": 640
    },
    "preprocessing": [
      {
        "preprocessing_type": "CenterCrop",
        "height": 320,
        "width": 640
      }
    ],
    "load_images": false,
    "batch_size": 1,
    "num_workers": 1,
    "pin_memory": true,
    "shuffle": false,
    "sequence_window": 1,
    "sequence_step": 1,
    "time_window_ms": 50
  },
  "model": {
    "model_type": "dae",
    "activation": "relu",
    "inv_prediction": true,
    "scale_factor": 1.0,
    "input_size_width": 350,
    "input_size_height": 266,
    "input_channels": 3,
    "freeze_encoder": false,
    "nopretrain": false,
    "checkpoint": "models/depthanyevent/weights/dav2/finetuned_mvsec/finetuned_mvsec.pth"
  },
  "vis_interval": 200,
  "vis_dir": "evaluate_output/evaluate_dsec_dae_tencode_on_MVSEC_checkpoint",
  "use_scaleshift": true,
  "clip_distance": 80.0,
  "inv_prediction": false,
  "inv_prediction_constant": 1.0,
  "csv_path": "evaluate_results/dsec_validation_dae_tencode_MVSEC_checkpoint.csv"
}
