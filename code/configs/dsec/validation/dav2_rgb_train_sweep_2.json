{
  "data_loader": {
    "dataset": "dsec",
    "datapath": "datasets/DSEC/data",
    "split": "train",
    "concatenate_sequences": false,
    "event_representation": {
      "representation_type": "rgb",
      "normalize": true,
      "white_frame": false,
      "height": 480,
      "width": 640
    },
    "preprocessing": [
      {
        "preprocessing_type": "CenterCrop",
        "height": 320,
        "width": 640
      }
    ],
    "load_images": true,
    "batch_size": 1,
    "num_workers": 1,
    "pin_memory": true,
    "shuffle": false,
    "sequence_window": 1,
    "sequence_step": 1,
    "time_window_ms": 50
  },
  "model": {
    "model_type": "dav2",
    "input_size_width": 350,
    "input_size_height": 266
  },
  "vis_interval": 200,
  "vis_dir": "evaluate_output/evaluate_dsec_train_dav2_rgb_sweep_2",
  "use_scaleshift": true,
  "clip_distance": 80.0,
  "inv_prediction": true,
  "inv_prediction_constant": 2.0,
  "csv_path": "evaluate_results/dsec_train_dav2_rgb_sweep_2.csv"
}
