{
  "data_loader": {
    "dataset": "dsec",
    "datapath": "datasets/DSEC/data",
    "split": "validation",
    "concatenate_sequences": false,
    "event_representation": {
      "representation_type": "rgb",
      "normalize": true,
      "white_frame": false,
      "height": 480,
      "width": 640
    },
    "preprocessing": [
      {
        "preprocessing_type": "CenterCrop",
        "height": 320,
        "width": 640
      }
    ],
    "load_images": true,
    "batch_size": 1,
    "num_workers": 1,
    "pin_memory": true,
    "shuffle": false,
    "sequence_window": 1,
    "sequence_step": 1,
    "time_window_ms": 50
  },
  "model": {
    "model_type": "unet_dav2_rgb",
    "input_channels": 3,
    "unet_base_channels": 32,
    "dav2_encoder": "vits",
    "dav2_checkpoint": "models/dav2/checkpoints/depth_anything_v2_vits.pth",
    "input_size_width": 350,
    "input_size_height": 266,
    "freeze_dav2": true,
    "checkpoint_path": "train_output/train_dsec_unet_dav2_rgb/epoch_025.pt",
    "normalize_imagenet": true
  },
  "vis_interval": 200,
  "vis_dir": "evaluate_output/evaluate_dsec_unet_dav2_rgb",
  "use_scaleshift": true,
  "clip_distance": 80.0,
  "inv_prediction": true,
  "inv_prediction_constant": 1.0,
  "csv_path": "evaluate_results/dsec_validation_unet_dav2_rgb.csv"
}
