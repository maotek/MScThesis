{
  "data_loader": {
    "dataset": "dsec",
    "datapath": "datasets/DSEC/data",
    "split": "train",
    "concatenate_sequences": false,
    "event_representation": {
      "representation_type": "voxelgrid",
      "channels": 5,
      "height": 480,
      "width": 640,
      "normalize": true
    },
    "preprocessing": [
      {
        "preprocessing_type": "CenterCrop",
        "height": 320,
        "width": 640
      }
    ],
    "load_images": false,
    "batch_size": 10,
    "num_workers": 1,
    "pin_memory": true,
    "shuffle": true,
    "sequence_window": 1,
    "sequence_step": 1,
    "time_window_ms": 50
  },
  "model": {
    "model_type": "unet_dav2",
    "input_channels": 5,
    "unet_base_channels": 8,
    "unet_type": "small2",
    "dav2_encoder": "vits",
    "dav2_checkpoint": "models/dav2/checkpoints/depth_anything_v2_vits.pth",
    "input_size_width": 350,
    "input_size_height": 266,
    "freeze_dav2": true,
    "normalize_imagenet": false
  },
  "training": {
    "epochs": 50,
    "lr": 0.0001,
    "weight_decay": 0.0,
    "clip_distance": 80.0,
    "log_interval": 100,
    "save_dir": "train_output/train_dsec_unet_small2_dav2_batch5_ch8",
    "save_every": 1,
    "ssi_alpha": 0.0,
    "ssi_scales": 4,
    "ssi_reduction": "batch",
    "grad_start_scale": 1,
    "grad_num_scales": 4,
    "grad_weight": 1.0,
    "delta": 0.25,
    "no_validation": false,
    "wandb_name": "train_dsec_unet_small2_dav2_batch5_ch8",
    "inv_prediction": true,
    "inv_prediction_constant": 1.0
  }
}
