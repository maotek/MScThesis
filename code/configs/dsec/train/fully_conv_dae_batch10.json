{
  "data_loader": {
    "dataset": "dsec",
    "datapath": "datasets/DSEC/data",
    "split": "train",
    "concatenate_sequences": false,
    "event_representation": {
      "representation_type": "voxelgrid",
      "channels": 5,
      "height": 480,
      "width": 640,
      "normalize": true
    },
    "preprocessing": [
      {
        "preprocessing_type": "CenterCrop",
        "height": 320,
        "width": 640
      }
    ],
    "load_images": false,
    "batch_size": 10,
    "num_workers": 1,
    "pin_memory": true,
    "shuffle": true,
    "sequence_window": 1,
    "sequence_step": 1,
    "time_window_ms": 50
  },
  "model": {
    "model_type": "fully_conv_dae",
    "input_channels": 5,
    "dae_encoder": "vits",
    "dae_checkpoint": "models/depthanyevent/weights/dav2/finetuned_dsec/finetuned_dsec.pth",
    "input_size_width": 350,
    "input_size_height": 266,
    "freeze_dae": true,
    "fc_output_channels": 3,
    "dae_input_channels": 3,
    "dae_activation": "relu",
    "dae_scale_factor": 1.0,
    "dae_inv_prediction": true,
    "freeze_encoder": false,
    "dae_nopretrain": false,
    "apply_sigmoid": true
  },
  "training": {
    "epochs": 50,
    "lr": 0.0001,
    "weight_decay": 0.0,
    "clip_distance": 80.0,
    "log_interval": 100,
    "save_dir": "train_output/train_dsec_fully_conv_dae_batch10",
    "save_every": 1,
    "ssi_alpha": 0.0,
    "ssi_scales": 4,
    "ssi_reduction": "batch",
    "grad_start_scale": 1,
    "grad_num_scales": 4,
    "grad_weight": 1.0,
    "delta": 0.25,
    "no_validation": false,
    "wandb_name": "train_dsec_fully_conv_dae_batch10",
    "inv_prediction": false,
    "inv_prediction_constant": 1.0
  }
}
